+def test_checkpoint_roundtrip_contains_ema_architecture_normalizers_split_and_budget(tmp_path: Path):
+    metadata = checkpoint_metadata()
+    data = SimpleNamespace(metadata=metadata, path=tmp_path / "synthetic.hdf5")
